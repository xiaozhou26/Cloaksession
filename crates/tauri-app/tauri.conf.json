{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MultiZen",
  "version": "0.1.0",
  "identifier": "com.multizen.browser",
  "build": {
    "beforeDevCommand": "npm run dev --prefix D:\\Rust\\multizen-browser-rs\\crates\\tauri-app\\ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix D:\\Rust\\multizen-browser-rs\\crates\\tauri-app\\ui",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MultiZen",
        "width": 1200,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
